# Server Configuration
PORT=3001
NODE_ENV=development

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
MASTER_SEED=your-bip39-mnemonic-phrase-for-hd-wallet-generation

# Database
DATABASE_PATH=./guardpay.db

# Blockchain RPC URLs (Testnets - ETH, BSC, Solana)
# Get free Alchemy API key at: https://www.alchemy.com
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR-API-KEY

# BSC Testnet (free, no API key needed)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Solana Devnet (free, no API key needed)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Price API
COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Monitoring
POLL_INTERVAL_MS=10000
CONFIRMATION_BLOCKS=3

# --- Platform fees (basis points; 100 = 1%) ---------------------------------
FEE_MERCHANT_BPS=100
FEE_P2P_BPS=50
FEE_ESCROW_BPS=150
FEE_ESCROW_MIN=1
# Where collected fees are sent. Without these, fees are computed but waived.
PLATFORM_FEE_ADDRESS=
PLATFORM_FEE_SOLANA_ADDRESS=
# Skip the fee transfer when it would cost more gas than it collects.
MIN_FEE_SWEEP=0

# --- Escrow (Base Commerce Payments Protocol) -------------------------------
# Chain key: base-sepolia | base
ESCROW_CHAIN=base-sepolia
BASE_RPC_URL=https://sepolia.base.org
# Operator key. GuardPay drives authorize/capture/void but never holds funds.
# Needs Base Sepolia ETH for gas. Falls back to m/44'/60'/7'/0/0 off MASTER_SEED.
OPERATOR_PRIVATE_KEY=
# Deal windows in seconds (preApproval <= authorization <= refund, enforced on-chain)
ESCROW_PREAPPROVAL_WINDOW=259200
ESCROW_AUTH_WINDOW=2592000
ESCROW_REFUND_WINDOW=5184000

# --- Solana escrow (CUSTODIAL — GuardPay holds a per-deal vault) ------------
# Unlike the Base escrow, there is no third-party contract here: funds sit in an
# address GuardPay controls. The UI states this per deal.
SOLANA_ESCROW_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SOLANA_ESCROW_SYMBOL=USDC
SOLANA_ESCROW_DECIMALS=6
# Rent each vault needs to open token accounts when releasing (lamports).
SOLANA_ESCROW_MIN_RENT=5000000

# --- Key handling -----------------------------------------------------------
# WALLET_ROLE:
#   all    (default) one process holds the seed and does everything — fine for dev
#   watch  derives and monitors addresses from WALLET_XPUB, holds NO keys
#   signer holds MASTER_SEED and performs sweeps/escrow actions
#
# For a split deployment: run the internet-facing API as `watch`, and a separate
# process with no inbound network as `signer`. Get the xpub with `pnpm xpub`.
# Caveat: ed25519 has no public-only derivation, so a watch-only process cannot
# mint Solana addresses — route Solana invoices to the signer.
WALLET_ROLE=all
WALLET_XPUB=

# Encrypts stored Solana/vault secret keys at rest (AES-256-GCM). Strongly
# preferred over the MASTER_SEED fallback: it can live in a KMS and be rotated
# independently. 32 bytes of hex, or any passphrase.
KEY_ENCRYPTION_KEY=

# --- x402 facilitator -------------------------------------------------------
# CAIP-2 networks this facilitator answers for. Testnet only by default.
X402_NETWORKS=eip155:84532
# Bound the settlement receipt wait below any gateway timeout, so a slow block
# reports settlement_pending with the tx hash instead of the request being killed.
X402_CONFIRM_TIMEOUT_MS=60000
